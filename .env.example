# Copy to .env and edit. Every line is optional: with no .env the bot runs fully offline.

# Where the index is stored.
# RAGBOT_INDEX_DIR=.ragbot

# Chunking, in words. Changing either one rebuilds the index on the next ingest.
# RAGBOT_CHUNK_SIZE=120
# RAGBOT_CHUNK_OVERLAP=20

# Retrieval: hybrid (BM25 + embeddings), bm25 or dense. Passages per answer.
# RAGBOT_RETRIEVAL=hybrid
# RAGBOT_TOP_K=5

# Refusal threshold (0-1). Leave unset to use the embedder's calibrated default.
# Required with RAGBOT_EMBEDDER=openai: run `ragbot eval --calibrate` to get a value.
# RAGBOT_MIN_SCORE=

# Embeddings: hashing (offline, lexical), fastembed (local model) or openai (any compatible API).
# RAGBOT_EMBEDDER=hashing
# RAGBOT_EMBEDDING_MODEL=
# RAGBOT_EMBEDDING_BASE_URL=https://api.openai.com/v1
# RAGBOT_EMBEDDING_API_KEY=

# Answers: extractive (offline, quotes the passage) or openai (any compatible chat API).
# For a local Ollama server use RAGBOT_LLM_BASE_URL=http://localhost:11434/v1 and no key.
# RAGBOT_ANSWERER=extractive
# RAGBOT_LLM_MODEL=
# RAGBOT_LLM_BASE_URL=https://api.openai.com/v1
# RAGBOT_LLM_API_KEY=

# Seconds to wait for an embedding or chat endpoint.
# RAGBOT_TIMEOUT_SECONDS=30
